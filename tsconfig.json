{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "lib/patreon-access.test.ts", "lib/patreon-notices.test.ts", "lib/profile.test.ts", "lib/obedience.test.ts", "lib/clipboard.test.ts", "lib/mail.test.ts", "lib/desktop.test.ts", "lib/db.test.ts", "lib/student-name.test.ts", "lib/resumable.test.ts", "lib/roster.test.ts"]
}
